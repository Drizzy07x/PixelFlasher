{
  "name": "pixelflasher-web-ui",
  "private": true,
  "version": "9.2.2",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "i18n:export": "node scripts/export-i18n.mjs",
    "i18n:check": "node scripts/verify-i18n.mjs",
    "build": "node scripts/export-i18n.mjs && node scripts/verify-i18n.mjs && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build && node scripts/verify-dist.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node scripts/export-i18n.mjs && vitest run",
    "test:coverage": "node scripts/export-i18n.mjs && vitest run --coverage",
    "test:watch": "vitest",
    "test:a11y": "vitest run -t accessibility"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/node": "24.13.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.12.1",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}

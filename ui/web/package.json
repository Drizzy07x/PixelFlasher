{
  "name": "pixelflasher-web-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "i18n:export": "node scripts/export-i18n.mjs",
    "i18n:check": "node scripts/verify-i18n.mjs",
    "build": "node scripts/export-i18n.mjs && node scripts/verify-i18n.mjs && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build && node scripts/verify-dist.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node scripts/export-i18n.mjs && vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run -t accessibility"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/node": "22.10.5",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "4.10.2",
    "jsdom": "25.0.1",
    "typescript": "5.7.3",
    "vite": "5.4.14",
    "vitest": "2.1.8"
  }
}

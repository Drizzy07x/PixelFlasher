msgid "CANCEL"
msgstr "CANCELAR"

msgid "         WARNING!!! WARNING!!! WARNING!!!\n\n\n"
msgstr "         ¡¡¡ADVERTENCIA!!! ¡¡¡ADVERTENCIA!!! ¡¡¡ADVERTENCIA!!!\n\n\n"

msgid "NEVER, EVER LOCK THE BOOTLOADER WITHOUT REVERTING\n\n"
msgstr "NUNCA, JAMÁS BLOQUEE EL BOOTLOADER SIN VOLVER\n\n"

